APP_ENV=development
HTTP_ADDR=:8080

DATABASE_URL=postgres://trotamundos:trotamundos@localhost:5432/trotamundos?sslmode=disable
# DATABASE_SHARDS=postgres://.../trotamundos?sslmode=disable
OLAP_DATABASE_URL=postgres://trotamundos:trotamundos@localhost:5432/trotamundos?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_ISSUER=trotamundos
JWT_ACCESS_TTL=15m
REFRESH_TTL=720h

# base64 de 32 bytes; cambiar en producción
TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

MOCK_CONTROL_KEY=dev-mock-key
WEBHOOK_KEY=dev-webhook-key

ENABLE_WORKERS=true
INGESTION_POLL_INTERVAL=2s
PROVIDER_SYNC_INTERVAL=2m
AUTO_ARCHIVE_INTERVAL=10m
STALE_EVENT_AFTER=2m

SEED_ANALYST_EMAIL=analyst@trotamundos.dev
SEED_ANALYST_PASSWORD=analyst12345

CORS_ALLOWED_ORIGIN=*
SHARD_COUNT=1
