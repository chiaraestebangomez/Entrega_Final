APP_ENV=development
HTTP_ADDR=:8080

DATABASE_URL=postgres://trotamundos:trotamundos@localhost:5432/trotamundos?sslmode=disable
# DATABASE_SHARDS=postgres://.../trotamundos?sslmode=disable
OLAP_DATABASE_URL=postgres://trotamundos:trotamundos@localhost:5432/trotamundos?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_ISSUER=trotamundos
JWT_ACCESS_TTL=15m
REFRESH_TTL=720h

# base64 de 32 bytes; cambiar en producción
TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

MOCK_CONTROL_KEY=dev-mock-key
WEBHOOK_KEY=dev-webhook-key

# CON-01: cuotas y API Key. En producción API_KEYS es obligatorio.
# Valores separados por coma; el cliente envía X-API-Key.
API_KEYS=
# Clave pública que la SPA lee desde /api-config.js. Por defecto, la primera de API_KEYS.
WEB_API_KEY=
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WINDOW=1m
# IPs o CIDRs separados por coma a los que se les confía X-Forwarded-For.
TRUSTED_PROXIES=

# Producción (APP_ENV=production) exige secretos reales y CORS explícito:
# TOKEN_ENCRYPTION_KEY, MOCK_CONTROL_KEY, WEBHOOK_KEY, API_KEYS y
# CORS_ALLOWED_ORIGIN (no "*").

ENABLE_WORKERS=true
INGESTION_POLL_INTERVAL=2s
PROVIDER_SYNC_INTERVAL=2m
AUTO_ARCHIVE_INTERVAL=10m
STALE_EVENT_AFTER=2m

RECOMMENDATION_RESULT_TTL=5m
RECOMMENDATION_SNAPSHOT_TTL=24h
RECOMMENDATION_POOL_TTL=24h
RECOMMENDATION_LOCK_TTL=10m
RECOMMENDATION_SIGNAL_WINDOW=720h
RECOMMENDATION_BATCH_INTERVAL=6h

SEED_ANALYST_EMAIL=analyst@trotamundos.dev
SEED_ANALYST_PASSWORD=analyst12345

CORS_ALLOWED_ORIGIN=*
SHARD_COUNT=1
